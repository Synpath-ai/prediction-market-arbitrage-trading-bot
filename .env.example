# Synpath API key (market matching and history): https://www.synpath.dev
SYNPATH_API_KEY=

# Kalshi (live trading only): API key id and the path to its private key (.pem)
# Create one at kalshi.com -> Account -> API Keys. KALSHI_ENV=demo uses Kalshi's practice exchange.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_ENV=prod

# Polymarket (live trading only): the private key of the wallet that signs orders, its type
# (3 deposit wallet, the default; 1 proxy; 2 Safe; 0 plain EOA) and, for types 1-3, the wallet
# address that holds the funds. API credentials are derived from the key automatically.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_SIGNATURE_TYPE=3
POLYMARKET_FUNDER=
